<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/textCapcalera"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/negre"
        android:gravity="center"
        android:text="Cartellera"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:contentDescription="Logo"
        android:src="@drawable/logo"
        app:layout_constraintBottom_toBottomOf="@id/textCapcalera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textCapcalera" />

    <ImageView
        android:id="@+id/btnCistella"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Cistella"
        android:padding="6dp"
        android:src="@drawable/ic_cart"
        app:layout_constraintBottom_toBottomOf="@id/textCapcalera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textCapcalera" />

    <TextView
        android:id="@+id/textComptador"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_comptador"
        android:gravity="center"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/btnCistella"
        app:layout_constraintTop_toTopOf="@id/btnCistella" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEsdeveniments"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textCapcalera" />

</androidx.constraintlayout.widget.ConstraintLayout>